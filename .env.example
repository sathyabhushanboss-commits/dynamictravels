# Copy this file to .env.local and fill in your values

# Business contact (used for tel:, WhatsApp, and email links)
NEXT_PUBLIC_BUSINESS_NAME="Networking Tours & Travels"
NEXT_PUBLIC_BUSINESS_PHONE="+917975630631"
NEXT_PUBLIC_BUSINESS_PHONE_DISPLAY="079756 30631"
NEXT_PUBLIC_WHATSAPP_NUMBER="917975630631"
NEXT_PUBLIC_BUSINESS_EMAIL="networkingtoursandtravels@gmail.com"

# Admin panel password (change this!)
ADMIN_PASSWORD="admin123"
# Long random string used to sign the admin login cookie (recommended)
ADMIN_SESSION_SECRET=

# ---------------------------------------------------------------------------
# Neon (serverless Postgres) — where bookings and rates are stored.
# This is what makes data actually persist when deployed on Vercel or any
# serverless host. If it's left blank the site still runs, but bookings are
# only kept in memory (lost on restart) and rates use the local JSON file.
#
# To set up: neon.tech -> create a project -> copy the "Connection string"
# (use the pooled one, host contains "-pooler"). It looks like:
#   postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# Tables are created automatically the first time the app runs.
# ---------------------------------------------------------------------------
DATABASE_URL=

# ---------------------------------------------------------------------------
# Razorpay — online payments for the "25% advance" and "100% now" options.
# The "Pay after ride" option needs no keys. Get these from the Razorpay
# Dashboard -> Settings -> API Keys (use test keys first: rzp_test_...).
# KEY_ID is safe to expose to the browser; KEY_SECRET must stay server-only.
# ---------------------------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ---------------------------------------------------------------------------
# Distance: still 100% keyless. Driving distance is computed from
# OpenStreetMap's free public routers (Valhalla + OSRM) on the server, and the
# booking page shows the route on a keyless Google Maps embed (no API key or
# billing needed). Optional: a small buffer added to the raw distance so per-km
# fares don't under-count vs Google. Default 0.10 (=+10%), range 0–1.
# ---------------------------------------------------------------------------
DISTANCE_BUFFER=0.10

# Optional: SMTP settings so the server can auto-email the owner on every
# booking. If left blank, email sending is simply skipped and the site still
# works fine (booking is stored + WhatsApp/Call buttons still work).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_TO="networkingtoursandtravels@gmail.com"

# ---------------------------------------------------------------------------
# SEO — see SEO-GUIDE.md
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://www.dynamictravels.in
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_YOUTUBE_URL=
NEXT_PUBLIC_GOOGLE_BUSINESS_URL=

# ---------------------------------------------------------------------------
# Email (Gmail) — lead + booking emails.
# Uses the SMTP_* settings above. For Gmail:
#   SMTP_HOST=smtp.gmail.com   SMTP_PORT=465
#   SMTP_USER=yourname@gmail.com
#   SMTP_PASS=<16-character App Password>  (Google Account -> Security ->
#             2-Step Verification -> App passwords; your normal password won't work)
#   SMTP_TO=where new-lead alerts go (defaults to NEXT_PUBLIC_BUSINESS_EMAIL)
# Every lead sends you an alert, and the customer gets a branded confirmation
# if they entered an email.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# WhatsApp Business Cloud API (Meta) — automatic WhatsApp messages.
# Optional: leave blank and the site still saves leads, emails you, and opens
# WhatsApp for the visitor. Fill in to also:
#   • send every new website lead "Hello <name>, are you looking for travel?…"
#   • auto-reply to anyone who messages your business number
#
# Setup (developers.facebook.com -> My Apps -> Create app -> Business -> add WhatsApp):
#   1. WHATSAPP_PHONE_NUMBER_ID  WhatsApp -> API Setup -> "Phone number ID"
#   2. WHATSAPP_TOKEN            a permanent System User token (Business Settings ->
#                                System users -> Generate token, permission
#                                whatsapp_business_messaging)
#   3. WHATSAPP_TEMPLATE_NAME    WhatsApp Manager -> Message templates -> create a
#                                "Utility" or "Marketing" template, e.g. lead_greeting:
#        Hello {{1}}! 👋 Thank you for contacting Dynamic Travels. Are you looking
#        for travelling? Reply with your pickup, destination and travel date and
#        our travel expert will share the best fare.
#      ({{1}} is filled with the customer's first name.) Wait for approval.
#   4. Webhook (for auto-replies): WhatsApp -> Configuration -> Webhook
#        Callback URL  https://<your-domain>/api/whatsapp/webhook
#        Verify token  same as WHATSAPP_VERIFY_TOKEN; then subscribe to "messages"
#   5. WHATSAPP_APP_SECRET       App settings -> Basic -> App secret (verifies webhooks)
# Note: a number connected to the Cloud API is managed through Meta, not the
# regular WhatsApp Business phone app (unless you enable "coexistence").
# ---------------------------------------------------------------------------
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=en
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# ---------------------------------------------------------------------------
# Logins — customer portal (/login → /account) and admin portal (/admin)
#
# Accounts live in their own tables: app_users, admin_users, otp_codes,
# user_sessions, admin_sessions (created automatically). To keep them in a
# completely separate Neon database, set AUTH_DATABASE_URL; otherwise
# DATABASE_URL is used.
#
# First run creates the owner admin from these (change the password after
# logging in: Admin → Admins → Change my password):
#   ADMIN_EMAIL     owner's login email (default: NEXT_PUBLIC_BUSINESS_EMAIL)
#   ADMIN_PHONE     owner's mobile (optional)
#   ADMIN_PASSWORD  owner's first password
# SESSION_SECRET signs login cookies — any long random string.
#
# OTP delivery (6-digit codes, 5-minute expiry):
#   Email  → the SMTP_* (Gmail) settings above
#   Mobile → FAST2SMS_API_KEY (fast2sms.com → Dev API, OTP route), or a
#            WhatsApp "Authentication" template named in WHATSAPP_OTP_TEMPLATE
#            (uses the WhatsApp Cloud API keys above)
# In development with none set, codes are printed in the `npm run dev` terminal.
# Admins: if no email/SMS delivery is configured in production, admin login
# falls back to password only (a warning is logged) so you're never locked out.
# ---------------------------------------------------------------------------
AUTH_DATABASE_URL=
SESSION_SECRET=
ADMIN_EMAIL=
ADMIN_PHONE=
FAST2SMS_API_KEY=
WHATSAPP_OTP_TEMPLATE=
